{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:netconfig-privacy-lab:schema:case-v1",
  "title": "Case sidecar (case-v1)",
  "description": "case.json: structure only (PLAN.md section 4, rows 36, 41, 42c). Benign spans and free-text labels are in labels.json; planted identifiers in ledger.json; expected answers in expected.json. IDs are opaque synthetic IDs, never hostnames. files[].path is an opaque on-disk path inside the case directory (n01.cfg); a planted file-name trap exists only in files[].name. interfaces[].ordinal = 1-based position among the file's interface blocks; aclEntries[].ordinal = 1-based position among the ACL's permit/deny entries (remarks excluded). Flows: <=32; exactly 32 for semantic-positive dev/held-out cases; 0 for unsupported cases; builder smoke cases may have fewer; ICMP flows carry ports 0. Referential integrity is checked by src/core/sidecar.ts (parseSidecar). Mirrors src/core/sidecar.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "caseId", "family", "stratum", "files", "nodes", "interfaces", "acls", "aclEntries", "flows"],
  "properties": {
    "schema": { "const": "case-v1" },
    "caseId": { "$ref": "#/$defs/id" },
    "family": { "enum": ["ring", "hub-and-spoke", "campus-tree", "dual-isp-edge"] },
    "stratum": { "enum": ["semantic-positive", "unsupported"] },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fileId", "path", "name", "nodeId"],
        "properties": {
          "fileId": { "$ref": "#/$defs/id" },
          "path": { "type": "string", "pattern": "^[a-z0-9]+\\.cfg$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$" },
          "nodeId": { "$ref": "#/$defs/id" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fileId"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "fileId": { "$ref": "#/$defs/id" } }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nodeId", "ordinal"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "nodeId": { "$ref": "#/$defs/id" },
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 16 }
        }
      }
    },
    "acls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nodeId", "aclName"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "nodeId": { "$ref": "#/$defs/id" },
          "aclName": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "aclEntries": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nodeId", "aclId", "aclName", "ordinal"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "nodeId": { "$ref": "#/$defs/id" },
          "aclId": { "$ref": "#/$defs/id" },
          "aclName": { "type": "string", "minLength": 1, "maxLength": 64 },
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 32 }
        }
      }
    },
    "flows": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/flow" }
    }
  },
  "if": { "properties": { "stratum": { "const": "unsupported" } } },
  "then": { "properties": { "flows": { "maxItems": 0 } } },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "ipv4": {
      "type": "string",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
    },
    "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ingressNodeId", "ingressInterfaceId", "src", "dst", "protocol", "srcPort", "dstPort"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ingressNodeId": { "$ref": "#/$defs/id" },
        "ingressInterfaceId": { "$ref": "#/$defs/id" },
        "src": { "$ref": "#/$defs/ipv4" },
        "dst": { "$ref": "#/$defs/ipv4" },
        "protocol": { "enum": ["tcp", "udp", "icmp"] },
        "srcPort": { "$ref": "#/$defs/port" },
        "dstPort": { "$ref": "#/$defs/port" }
      },
      "if": { "properties": { "protocol": { "const": "icmp" } } },
      "then": { "properties": { "srcPort": { "const": 0 }, "dstPort": { "const": 0 } } }
    }
  }
}
